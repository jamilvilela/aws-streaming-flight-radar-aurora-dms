# =============================================================================
# TEMPLATE — copie para terraform.tfvars e preencha com os valores do ambiente
#   cp infra/tfvars/terraform.tfvars.example infra/tfvars/terraform.tfvars
# NUNCA commite o terraform.tfvars real (contém dados sensíveis).
# Segredos (senha do banco) devem ir via .env → TF_VAR_rds_admin_password.
# =============================================================================

aws_region   = "us-east-1"
project_name = "flight-radar-stream"
environment  = "production"
vpc_name     = "default-vpc"

tags = {
  Environment = "production"
  Project     = "flight-radar-stream"
  ManagedBy   = "terraform"
}

# =============================================================================
# Aurora Serverless v2 PostgreSQL Configuration
# =============================================================================
aurora_config = {
  # SECURITY: restrito ao CIDR da VPC (descoberto via data source).
  # NÃO usar 0.0.0.0/0 — expõe o PostgreSQL à internet.
  allowed_cidr_blocks = []
  db_name             = "flightradar"
  admin_username      = ""
  admin_password      = "" # override via DB_PASSWORD in .env

  serverless_min_capacity = 0
  serverless_max_capacity = 2

  backup_retention_days      = 7
  publicly_accessible        = false
  snapshot_identifier        = null
  skip_final_snapshot        = false
  final_snapshot_identifier  = "flight-radar-stream-final-snapshot"
  deletion_protection        = false
  log_retention_days         = 30
  create_log_group           = false
  reader_count               = 0
  auto_minor_version_upgrade = true
}